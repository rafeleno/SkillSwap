{
  "compilerOptions": {
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@widgetComponents/*": ["../src/widgets/*"],
      "@pageComponents/*": ["../src/pages/*"],
      "@uiComponents/*": ["../src/shared/ui/*"],
      "@images/*": ["../public/images/*"],
      "@svg/*": ["../public/svg/*"]
    }
  },
  "include": ["src"]
}

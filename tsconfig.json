{
  "compilerOptions": {
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@widgetComponents/*": ["widgets/*"],
      "@pageComponents/*": ["pages/*"],
      "@uiComponents/*": ["ui/*"],
      "@colors": ["styles/_colors.scss"],
      "@typographyStyles": ["styles/_typography.scss"]
    }
  },
  "include": ["src"]
}
